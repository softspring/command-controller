{
    "name": "softspring/command-controller",
    "description": "This library allows running commands from Symfony controllers.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^1.0",
        "symfony/console": "^6.4|^7.3",
        "symfony/framework-bundle": "^6.4|^7.3",
        "symfony/http-kernel": "^6.4|^7.3"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\CommandController\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    }
}
